{
  "triggers": [
    {
      "id": "operatingmode_changed",
      "title": {
        "en": "Status changed",
        "nl": "Status gewijzigd"
      }
    },
    {
      "id": "comfortchargelevel_changed",
      "title": {
        "en": "Comfort charge level changed",
        "nl": "Comfort laadniveau veranderd"
      },
      "tokens": [
        {
          "name": "comfortchargelevel",
          "type": "number",
          "title": {
            "en": "Comfort charge level",
            "nl": "Comfort laadniveau"
          },
          "example": 2500
        }
      ]
    },
    {
      "id": "chargetype_changed",
      "title": {
        "en": "Charge mode changed",
        "nl": "Manier van laden veranderd"
      },
      "tokens": [
        {
          "name": "chargetype",
          "type": "string",
          "title": {
            "en": "Charge mode",
            "nl": "Manier van laden"
          },
          "example": "1"
        }
      ]
    },
    {
      "id": "wallbox_rebooted",
      "title": {
        "en": "Wallbox rebooted",
        "nl": "Laadpaal is herstart"
      },
      "hint": {
        "en": "Fires when the charger's boot count goes up (seen at the next poll).",
        "nl": "Gaat af als het aantal opstarts van de laadpaal stijgt (gezien bij de volgende poll)."
      },
      "tokens": [
        {
          "name": "bootups",
          "type": "number",
          "title": {
            "en": "Boot count",
            "nl": "Aantal opstarts"
          },
          "example": 6551
        },
        {
          "name": "boot_reason",
          "type": "string",
          "title": {
            "en": "Boot reason",
            "nl": "Opstartreden"
          },
          "example": "Watchdog reset"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "greenshare",
